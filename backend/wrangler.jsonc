{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizik-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.5"
  },
  // Per-IP rate limit via KV (manual sliding window). Native `unsafe.bindings`
  // RateLimit didn't engage on free tier — KV works reliably.
  "kv_namespaces": [
    {
      "binding": "RATELIMIT_KV",
      "id": "68cfa756fcfc4217a9640edab785975e"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizik-db",
      "database_id": "946aacc2-f615-4b4d-a8d7-177118137103"
    }
  ]
  // Secrets (NOT in this file — set via `wrangler secret put`):
  //   OPENAI_API_KEY     — OpenAI API key
  //   CLERK_SECRET_KEY   — Clerk secret for JWT verification
  //   STRIPE_SECRET_KEY  — Stripe secret key
  //   STRIPE_WEBHOOK_SECRET — Stripe webhook signing secret
}
