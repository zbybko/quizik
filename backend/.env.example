# Local dev only — wrangler dev reads this automatically.
# For production set these as Cloudflare secrets:
#   npm run secret:openai   (or: wrangler secret put OPENAI_API_KEY)
#   npm run secret:app      (or: wrangler secret put APP_SHARED_SECRET)
OPENAI_API_KEY=sk-proj-your-key
APP_SHARED_SECRET=change-me

# Non-secret override (or set in wrangler.jsonc → vars)
# OPENAI_MODEL=gpt-5.5
