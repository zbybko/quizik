{
  "manifest_version": 3,
  "name": "Quizik",
  "short_name": "Quizik",
  "description": "AI study chat for any quiz page. Ask questions, get hints, understand the concept behind the answer.",
  "version": "0.1.0",
  "author": "Zakhar Bybko",
  "homepage_url": "https://github.com/zbybko/quizik",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "storage", "sidePanel", "tabs"],
  "externally_connectable": {
    "matches": [
      "https://quizik-backend.zakhar-bybko.workers.dev/*",
      "https://quizik-backend-dev.zakhar-bybko.workers.dev/*"
    ]
  },
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Quizik — AI study chat",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://accounts.content-escargot-11.clerk.accounts.dev/*"
      ],
      "js": ["clerk-auth.js"],
      "run_at": "document_idle"
    }
  ]
}
